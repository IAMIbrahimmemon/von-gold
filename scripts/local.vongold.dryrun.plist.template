<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.vongold.dryrun</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPO_DIR_PLACEHOLDER/scripts/tick_and_publish.sh</string>
    </array>

    <!-- Weekdays at 13:15 local time (after the US cash close on the west coast).
         StartCalendarInterval fires missed jobs on wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>15</integer></dict>
    </array>

    <!-- RunAtLoad=true, KeepAlive=false: a scheduled job that exits, not a daemon. -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- launchd starts with a minimal PATH; the tick script needs git and the venv. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>REPO_DIR_PLACEHOLDER/runtime/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPO_DIR_PLACEHOLDER/runtime/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>REPO_DIR_PLACEHOLDER</string>
</dict>
</plist>
