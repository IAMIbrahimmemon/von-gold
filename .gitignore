# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Data: large and regenerable. The parquet cache and raw payloads stay local.
# NOTE: this must ignore data/raw/* (not data/raw/) -- git will not descend into an
# ignored directory, so a "!file" negation inside an ignored dir silently does nothing.
data/raw/*
# ...except the 58-year LBMA gold series (915KB). The long-history result depends on it
# and it has no cheap re-fetch, so it ships with the repo.
!data/raw/lbma_gold_pm.json
data/processed/*.parquet
data/processed/*.jsonl
hf_orig/
hfcache/

# Runtime: the switch, ledger and status ARE meant to be committed (they are the
# control channel and the audit trail), so they are not ignored. Position state is
# local-only bookkeeping.
runtime/position.json

# OS
.DS_Store
